# ---------------------------------------------------------------------------
# Chat 模型（OpenAI 兼容）—— 用于对话 / 规划。
# DeepSeek 示例 base_url = https://api.deepseek.com（程序自动追加 /chat/completions）。
# ---------------------------------------------------------------------------
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_TIMEOUT=20

# ---------------------------------------------------------------------------
# Embedding 模型（独立配置，不得复用 Chat 的 base_url / model）。
# 工业界做法：Chat 与 Embedding 通常是不同服务/模型；Chat provider 不一定提供 Embedding。
# 三项（BASE_URL / API_KEY / MODEL）缺一不可；缺失时 RAG 返回 unavailable，
# 不会静默回退到本地 SVD，也不会根据 Chat URL 猜测 Embedding 模型。
#
# API Key 说明：
#   - 如果 Embedding 和 Chat 用同一个服务商（如都用 OpenAI），API Key 相同
#   - 如果是不同服务商，API Key 不同（各服务商各有一把 key）
#
# ============================================================
# 模板 A：OpenAI 官方（国际，需科学上网）
# ============================================================
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxx          # 和 Chat 的 OpenAI key 相同
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536         # text-embedding-3-small 默认 1536，可留空
# EMBEDDING_TIMEOUT=30
#
# ============================================================
# 当前默认：本地 Ollama + Qwen3-Embedding-0.6B（免费）
# 首次使用前执行：ollama pull qwen3-embedding:0.6b
# Ollama 的 API key 仅为 OpenAI SDK 必填占位，服务端会忽略。
# ============================================================
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT=30

# ---------------------------------------------------------------------------
# MCP Server（生产默认传输：Streamable HTTP）
# 外部 MCP 按最小权限仅暴露 auto 只读工具；confirm/mutation 保留在 LangGraph 审批链。
# 真实模型生产启动（use_fake_model=false）要求本值非空，否则 fail-fast。
# 示例：MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# ---------------------------------------------------------------------------
MCP_SERVER_URL=

# ---------------------------------------------------------------------------
# Milvus（向量检索，RAG 生产主路径）。
# 官方 langchain-milvus 集成：稠密（IP）+ BM25 sparse + RRF 混合检索。
# 独立于 Chat / Embedding 配置。
# 必须显式指向 Docker Milvus Standalone（参见 docker-compose.yml，Milvus v2.6+）：
#   MILVUS_URI=http://127.0.0.1:19530
#
# 留空 = 未配置 → rag_search 返回结构化 unavailable（禁止回退到嵌入式 Milvus Lite）。
# 原因：
#   - milvus-lite 在 Windows 上不被官方支持；
#   - 生产路径必须指向 Docker Milvus Standalone；
#   - RRF reranker 要求 Milvus server 2.6+。
# ---------------------------------------------------------------------------
MILVUS_URI=
MILVUS_COLLECTION=rag_knowledge
MILVUS_TIMEOUT=10
