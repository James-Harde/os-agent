# ---------------------------------------------------------------------------
# Chat 模型（OpenAI 兼容）—— 用于对话 / 规划。
# DeepSeek 示例 base_url = https://api.deepseek.com（程序自动追加 /chat/completions）。
# ---------------------------------------------------------------------------
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_TIMEOUT=20

# ---------------------------------------------------------------------------
# Embedding 模型（独立配置，不得复用 Chat 的 base_url / model）。
# 工业界做法：Chat 与 Embedding 通常是不同服务/模型；Chat provider 不一定提供 Embedding。
# 三项（BASE_URL / API_KEY / MODEL）缺一不可；缺失时 RAG 返回 unavailable，
# 不会静默回退到本地 SVD，也不会根据 Chat URL 猜测 Embedding 模型。
#
# 示例（OpenAI 官方）：
#   EMBEDDING_BASE_URL=https://api.openai.com/v1
#   EMBEDDING_API_KEY=sk-xxx
#   EMBEDDING_MODEL=text-embedding-3-small
# 示例（本地 Ollama/vLLM 等 OpenAI 兼容服务——需确认该入口支持 embedding）：
#   EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
#   EMBEDDING_API_KEY=ollama
#   EMBEDDING_MODEL=nomic-embed-text
# ---------------------------------------------------------------------------
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_TIMEOUT=30

# ---------------------------------------------------------------------------
# Milvus（向量检索，RAG 生产主路径）。
# 官方 langchain-milvus 集成：稠密（IP）+ BM25 sparse + RRF 混合检索。
# 独立于 Chat / Embedding 配置。
# 必须显式指向 Docker Milvus Standalone（参见 docker-compose.yml，Milvus v2.6+）：
#   MILVUS_URI=http://127.0.0.1:19530
#
# 留空 = 未配置 → rag_search 返回结构化 unavailable（禁止回退到嵌入式 Milvus Lite）。
# 原因：
#   - milvus-lite 在 Windows 上不被官方支持；
#   - 生产路径必须指向 Docker Milvus Standalone；
#   - RRF reranker 要求 Milvus server 2.6+。
# ---------------------------------------------------------------------------
MILVUS_URI=
MILVUS_COLLECTION=rag_knowledge
MILVUS_TIMEOUT=10
